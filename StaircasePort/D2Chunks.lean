/-! ## Packing primitives (width-parametric; the R8 `catB`/`fieldOf` shapes) -/

/-- Little-endian bit catenation: element 0 lands in the MOST significant field.
(The R8 seed file uses the same `foldr`; `orientation` in the certificate pins which
index `fieldOf` then reads.) -/
def catB (B : ℕ) (l : List ℕ) : ℕ := l.foldr (fun x acc => x ||| (acc <<< B)) 0

/-- Width-`w` field `i` of a packed code state. -/
def fieldOf (X w i : ℕ) : ℕ := (X >>> (w * i)) &&& (2 ^ w - 1)

/-- Pack a code function over `NL` wires. -/
def packCodes (f : ℕ → ℕ) : ℕ := catB 17 ((List.range NL).map f)

/-- Decode a wire. `foldr (fun x acc => x ||| (acc <<< B))` puts element 0 in the
LOWEST field, so wire `w` is field `w` (the certificate pins orientation=identity by
a full %d-field round-trip). NOTE: this is a *full* 17-bit code per field; the R8
GenData_0 words appear to shift the code by 4 (code<<4) to leave a dim nibble, which
this pack does NOT replicate - the two packings are not interchangeable. -/
def codeOf (S : ℕ) (w : ℕ) : ℕ := fieldOf S 17 w

