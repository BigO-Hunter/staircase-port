/-- The value-pin projection of the regenerated block list: the cut sets were extracted
for exactly the blocks (and values) pinned in `stairNEBlocks`. -/
theorem stairNEBlocksX_map :
    stairNEBlocksX.map (fun b => (b.i, b.j, b.rho, b.cut)) = stairNEBlocks := by rfl

/-- Per-block cardinality/range side condition of the cut data (the Finset-cardinality
preconditions: nodup raw lists, elements in range, |R0|+|C0|+|T0| = cut). -/
def stairNEcardOK (b : StairNEBlock) : Bool :=
  decide (b.R0.length + b.C0.length + b.T0.length = b.cut) &&
  decide (b.i < 45) && decide (b.j < 45) &&
  b.R0.all (fun r => r < 45) && b.C0.all (fun c => c < 45) &&
  b.T0.all (fun t => t < 47) &&
  decide b.R0.Nodup && decide b.C0.Nodup && decide b.T0.Nodup

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
theorem stairNE_cuts_card : stairNEBlocksX.all stairNEcardOK = true := by decide

/-- Per-block cut-certificate condition (check_stair.py:87-89, reordered to iterate the
small support lists): every term outside `T0` has all of its row support inside the
block rows (`r <= i`) within `R0`, or all of its col support inside the block cols
(`j <= c`) within `C0`. -/
def stairNEcoverOK (b : StairNEBlock) : Bool :=
  (List.range 47).all fun t =>
    decide (t ∈ b.T0) ||
    (stairNESr.getD t []).all (fun r => !decide (r ≤ b.i) || decide (r ∈ b.R0)) ||
    (stairNESc.getD t []).all (fun c => !decide (b.j ≤ c) || decide (c ∈ b.C0))

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
theorem stairNE_cuts_cover : stairNEBlocksX.all stairNEcoverOK = true := by decide

